{
  "name": "orchestrarr",
  "version": "0.3.1",
  "private": true,
  "license": "AGPL-3.0-only",
  "engines": {
    "node": ">=22.18.0"
  },
  "description": "Local-first operations dashboard for a Plex media stack",
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "vite build",
    "start": "node server.js",
    "lint:names": "node scripts/check_file_names.mjs",
    "check": "yarn lint:names && eslint . && tsc --noEmit && node --check server.js && node --check scripts/dev.mjs && node --check scripts/docker_smoke.mjs",
    "test": "node --test tests/*.test.mjs && vitest run",
    "test:docker": "node scripts/docker_smoke.mjs",
    "lint": "yarn lint:names && eslint ."
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^9",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/eslint-plugin-jsx-a11y": "^6",
    "@types/jsdom": "^30",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "eslint": "^9",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "jsdom": "^30.1.3",
    "sass": "^1.105.2",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.71.2",
    "vite": "^7.3.6",
    "vitest": "^5.0.5"
  },
  "packageManager": "yarn@4.18.0"
}
