# Docker Compose reads this file. The Node server does not load .env automatically.
# Optional: without a key, Orchestrarr generates one on first start and prints it in the logs.
# To choose your own, generate one with: openssl rand -hex 32
ORCHESTRARR_API_KEY=

# Optional shared secret for Sonarr, Radarr and Plex webhooks.
# Generate with: openssl rand -hex 32
ORCHESTRARR_WEBHOOK_SECRET=
